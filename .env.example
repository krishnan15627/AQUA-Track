PORT=3000
JWT_SECRET=aquatrack_super_secret_jwt_key_2025_watercan_mgmt
NODE_ENV=development

# Supabase — Project Settings -> API
# Use the service_role / secret key (server-side only, never in the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps JavaScript API browser key for the customer "shops near you" map.
# Create it in Google Cloud Console (enable Maps JavaScript API) and restrict it:
# Application restriction = HTTP referrers (e.g. http://localhost:3000/*, https://yourdomain.com/*),
# API restriction = Maps JavaScript API. Billing must be enabled on the project.
MAPS_BROWSER_KEY=
